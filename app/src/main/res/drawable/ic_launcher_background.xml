<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Material 3 Deep Navy to Cobalt Gradient Surface -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="15"
                android:startY="15"
                android:endX="95"
                android:endY="95"
                android:type="linear">
                <item android:color="#1A3B70" android:offset="0.0" />
                <item android:color="#0B1A30" android:offset="0.5" />
                <item android:color="#060E1A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Material Ripple Outer Ring -->
    <path
        android:pathData="M54,16 A38,38 0 1,1 53.9,16"
        android:strokeWidth="1.2"
        android:strokeColor="#18FFFFFF"
        android:fillColor="#00000000" />

    <!-- Subtle Material Ripple Mid Ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26"
        android:strokeWidth="1.0"
        android:strokeColor="#2500E5FF"
        android:fillColor="#00000000" />

    <!-- Soft Ambient Glow behind the cloud -->
    <path
        android:pathData="M54,34 A20,20 0 1,1 53.9,34">
        <aapt:attr name="android:fillColor">
            <gradient
                android:gradientRadius="22"
                android:centerX="54"
                android:centerY="52"
                android:type="radial">
                <item android:color="#3500B4D8" android:offset="0.0" />
                <item android:color="#0000B4D8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
